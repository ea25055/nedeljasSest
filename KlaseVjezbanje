

public class Soba {
	
	private int brSobe;
	private int kvadratura;
	private int brKreveta;
	private boolean miniBarDaNe;
	private boolean tvDaNe;
	private boolean telDaNe;
	
	public static double osnovaZaCijenu;
	
	public int getBrSobe() {
		return brSobe;
	}
	public void setBrSobe(int brSobe) {
		if(brSobe>=100 && brSobe<=999) {
			this.brSobe = brSobe;
		}else {
			System.out.println("Greska u unosu sobe");
			this.brSobe = 0;
		}
	}
	public int getKvadratura() {
		return kvadratura;
	}
	public void setKvadratura(int kvadratura) {
		this.kvadratura = kvadratura;
	}
	public int getBrKreveta() {
		return brKreveta;
	}
	public void setBrKreveta(int brKreveta) {
		this.brKreveta = brKreveta;
	}
	public boolean isMiniBarDaNe() {
		return miniBarDaNe;
	}
	public void setMiniBarDaNe(boolean miniBarDaNe) {
		this.miniBarDaNe = miniBarDaNe;
	}
	public boolean isTvDaNe() {
		return tvDaNe;
	}
	public void setTvDaNe(boolean tvDaNe) {
		this.tvDaNe = tvDaNe;
	}
	public boolean isTelDaNe() {
		return telDaNe;
	}
	public void setTelDaNe(boolean telDaNe) {
		this.telDaNe = telDaNe;
	}
	public Soba(int brSobe, int kvadratura, int brKreveta, boolean miniBarDaNe, boolean tvDaNe, boolean telDaNe) {
		super();
		this.setBrSobe(brSobe);
		this.kvadratura = kvadratura;
		this.brKreveta = brKreveta;
		this.miniBarDaNe = miniBarDaNe;
		this.tvDaNe = tvDaNe;
		this.telDaNe = telDaNe;
	}
	
	public int dajSprat() {
		int sprat = brSobe/100;
		return sprat;
	}
	
	public double izracunajCijenuPoDanu() {
		int nadnoknadaBar = 0;
		if(miniBarDaNe == true) nadnoknadaBar = 5;
		
		int nadnoknadaTV = 0;
		if(tvDaNe == true) nadnoknadaTV = 5;
		
		int nadnoknadaTel = 0;
		if(telDaNe == true) nadnoknadaTel = 5;
		
		double cijena = osnovaZaCijenu*(kvadratura/10 + 3*brKreveta)+nadnoknadaBar+nadnoknadaTV+nadnoknadaTel;
		
		return cijena;
	}
	
	
	public String infoOSobi() {
		return "Soba [brSobe=" + brSobe + ", kvadratura=" + kvadratura + ", brKreveta=" + brKreveta + ", miniBarDaNe="
				+ miniBarDaNe + ", tvDaNe=" + tvDaNe + ", telDaNe=" + telDaNe + "]";
}
}


