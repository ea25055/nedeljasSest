import java.util.ArrayList;

public class Student {
	
	//atributi klase
	private String ime;
	private String prezime;
	private String brIndex;
	private double prosjek;
	
	public Student() {
		this.ime=null;
		this.prezime="";
		this.brIndex="";
		this.prosjek=0;
	}
	
	
	public Student(String ime, String prezime, String brIndex, double prosjek) {
		this.ime = ime;
		this.prezime = prezime;
		this.brIndex = brIndex;
		this.setProsjek(prosjek);
	}


	public String getIme() {
		return ime;
	}


	public void setIme(String ime) {
		this.ime = ime;
	}


	public String getPrezime() {
		return prezime;
	}


	public void setPrezime(String prezime) {
		this.prezime = prezime;
	}


	public String getBrIndex() {
		return brIndex;
	}


	public void setBrIndex(String brIndex) {
		this.brIndex = brIndex;
	}


	public double getProsjek() {
		return prosjek;
	}


	public void setProsjek(double prosjek) {
		if(prosjek>=5 && prosjek<=10) {
			this.prosjek = prosjek;
		}else {
			this.prosjek = 0;
			System.out.println("Greska u unosu prosjeka");
		}
	}


	@Override
	public String toString() {
		return "Student [ime=" + ime + ", prezime=" + prezime + ", brIndex=" + brIndex + ", prosjek=" + prosjek + "]";
	}
	
	
