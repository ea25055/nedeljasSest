//1. Napisati metod void updateArray (int a, int [] b) koji svaki element niza b
//mijenja po sljedećim pravilima: ako je element veći od 0, umanjuje ga za a, a u suprotnom ga
//uvećava za a.

public static void updateArray(int a, int[] b) {
	for (int i = 0; i < b.length; i++) {
		if (b[i] > 0) {
			b[i] = b[i] - a;
		} else {
			b[i] = b[i] + a;
		}
	}
}

//2. Napisati metod int minArray(int a, int [] b) koji vraća minimalni element niza b
//koji je veći od a.

public static int minArray(int a, int[] b) {
	int min = b[0];
	for (int i = 0; i < b.length; i++) {
		if (b[i] > a && b[i] < min) {
			min = b[i];
		}
	}
	return min;
}
//4. Napisati metod void fillThirteenSeventeen(int a, int [] b) koji popunjava
//niz b brojevima većim od a koji su djeljivi sa 13 ili 17, u rastućem redosljedu.
public static void fillThirteenSeventeen(int a, int[] b) {
	int brojac = a;
	int i = 0;
	while (brojac < Integer.MAX_VALUE) {

		if (i == b.length)
			break;

		if (brojac % 13 == 0 || brojac % 17 == 0) {
			b[i] = brojac;
			i++;
		}

		brojac++;
	}
}

//5. Napisati metod int zeroElem(int [] b) koji vraća broj parova uzastopnih elemenata
//niza b koji završavaju sa bar jednom nulom.

// 10 8 10 20 43 40 50 600

public static int zeroElem(int[] b) {
	int br = 0;
	for (int i = 0; i < b.length - 1; i++) {
		if (b[i] % 10 == 0 && b[i + 1] % 10 == 0) {
			br++;
		}
	}
	return br;
}

//Napisati metod int sumaNajvecihSusjeda(int []b) koji sumira sve elemnte niza koji su najveci susjedi.
// element je najveci susjed ako je veci od oba svoja susjeda

// 1 3 2 5 4 10 4

public static int sumaNajvecihSusjeda(int[] b) {
	int suma = 0;

	for (int i = 1; i < b.length - 1; i++) {
		if (b[i] > b[i - 1] && b[i] > b[i + 1]) {
			suma = suma + b[i];
		}
	}

	return suma;
}

//6. Napisati metod int changeSign(int [] b) koji za dati niz nenultih cijelih brojeva b
//vraća koliko se puta mijenja znak u nizu b posmatrajući elemente od početka. Na primjer, u
//nizu 10, -4, 12, 56, -8, -9, znak se mijenjao 3 puta.

public static int changeSign(int[] b) {
	int br = 0;
	for (int i = 0; i < b.length - 1; i++) {
		if ((b[i] > 0 && b[i + 1] < 0) || (b[i] < 0 && b[i + 1] > 0)) {
			br++;
		}
	}
	return br;
}

//8. Napisati metod void shiftLeft(int [] b) koji dati niz cijelih brojeva b pomjera za
//jednu poziciju ulijevo. Npr. za ulazni niz (1,4,2,7), niz se transformiše u (4,2,7,1).

// b[i] = b[i+1]
public static void shiftLeft(int[] b) {
	int pom = b[0];
	for (int i = 0; i < b.length - 1; i++) {
		b[i] = b[i + 1];
	}
	b[b.length - 1] = pom;
}

