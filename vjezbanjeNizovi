//13. Napisati metod int parneCifre(int[] b, int k) koji štampa sve elemente niza b
//koji u dekadnom zapisu imaju bar k parnih brojeva. Metod vraća broj takvih elemenata u nizu.

public static int brParnihCifara(int n) {
	int br = 0;

	while (n >= 0) {
		int cif = n % 10;
		if (cif % 2 == 0)
			br++;
		n = n / 10;
	}

	return br;
}

public static int parneCifre(int[] b, int k) {
	int br = 0;
	for (int i = 0; i < b.length; i++) {
		if (brParnihCifara(b[i]) >= k) {
			System.out.println(b[i]);
			br++;
		}
	}
	return br;

}

//14. Napisati metod void prosteCifre(int[] b) koji štampa sve elemente niza b koji u
//dekadnom zapisu imaju bar jedan prost broj.
public static int brProstihCifara(int n) {
	int br = 0;

	while (n >= 0) {
		int cif = n % 10;
		if (prost(cif))
