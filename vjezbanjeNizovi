//15. Napisati metod int minArray(int [] b) koji vraća onaj element niza koji je najbliži
//aritmetičkoj sredini niza b. Ako ima više takvih elemenata, vratiti bilo koji.

// 4 1 3 2 5
// sredina 3

public static int minArtArray(int[] b) {
	double prosjek = prosjek(b);

	int najblizi = b[0];
	double minDistanca = Math.abs(b[0] - prosjek);

	for (int i = 0; i < b.length; i++) {

		if (Math.abs(b[i] - prosjek) < minDistanca) {
			minDistanca = Math.abs(b[i] - prosjek);
			najblizi = b[i];
		}

	}

	return najblizi;

}


	
